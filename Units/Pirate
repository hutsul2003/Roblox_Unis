--====================================================

local lastAttackTime = 0
local isAttacking = false
local isClimbing = false
local climbStartTime = 0
local climbStartCFrame = nil
local lastClimbTime = -math.huge
local climbGroundGraceUntil = 0
local isJumping = false
local jumpStartTime = 0
local lastJumpTime = -math.huge
local jumpDirection = Vector3.zero
local jumpMoveSpeed = 0
local jumpGroundGraceUntil = 0
local clearPath
local forcePathRecompute
local lastPathMovePosition
local lastPathMoveTime
local avoidancePoint
local avoidancePointExpiresAt

local currentTargetCharacter = nil
local isChasingEscapedTarget = false

local function clearTarget()
	currentTargetCharacter = nil
	isChasingEscapedTarget = false
	clearPath()
end

local function stopMovement()
	local velocity = rootCollider.AssemblyLinearVelocity
	rootCollider.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
end

local movementRaycastParams = RaycastParams.new()
movementRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
movementRaycastParams.IgnoreWater = true

local function updateMovementRaycastFilter()
	local filterList = { npc }

	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(filterList, player.Character)
		end
	end

	for _, other in ipairs(CollectionService:GetTagged(UNIT_TAG)) do
		if other ~= npc then
			table.insert(filterList, other)
		end
	end

	movementRaycastParams.FilterDescendantsInstances = filterList
end

local function raycastMovementObstacle(direction, distance, scanHeight)
	if direction.Magnitude <= 0.05 then
		return nil
	end

	updateMovementRaycastFilter()
	local origin = rootCollider.Position + Vector3.new(0, scanHeight or AVOIDANCE_SCAN_HEIGHT, 0)
	return workspace:Raycast(origin, direction.Unit * distance, movementRaycastParams)
end

local function objectNameContains(object, keywords)
	local current = object

	while current and current ~= workspace do
		local lowerName = string.lower(current.Name)

		for _, keyword in ipairs(keywords) do
			if string.find(lowerName, keyword, 1, true) then
				return true
			end
		end

		current = current.Parent
	end

	return false
end

local function isClimbableFenceHit(result)
	if not result or not result.Instance or not result.Instance:IsA("BasePart") then
		return false
	end

	local blockedKeywords = { "stone", "rock", "кам", "скал", "barrel", "torch", "tent" }
	if objectNameContains(result.Instance, blockedKeywords) then
		return false
	end

	local explicitFenceKeywords = { "fence", "забор", "palisade", "picket" }
	local part = result.Instance
	local height = part.Size.Y
	local thickness = math.min(part.Size.X, part.Size.Z)

	if objectNameContains(part, explicitFenceKeywords) then
		return height >= CLIMB_MIN_OBSTACLE_HEIGHT and height <= CLIMB_MAX_OBSTACLE_HEIGHT
	end

	-- У декоративных заборов части не всегда названы Fence, поэтому допускаем
	-- тонкие вертикальные препятствия высотой примерно с палисад/забор.
	return height >= CLIMB_MIN_OBSTACLE_HEIGHT
		and height <= CLIMB_MAX_OBSTACLE_HEIGHT
		and thickness <= 2.8
		and math.abs(result.Normal.Y) < 0.45
end

local function updateClimbMotion()
	if not isClimbing or not climbStartCFrame then
		return false
	end

	local elapsed = os.clock() - climbStartTime
	local climbProgress = 0

	if elapsed > CLIMB_ASCEND_DELAY then
		climbProgress = math.clamp(
			(elapsed - CLIMB_ASCEND_DELAY) / (CLIMB_TOTAL_DURATION - CLIMB_ASCEND_DELAY),
			0,
			1
		)
	end

	rootCollider.CFrame = climbStartCFrame + Vector3.new(0, CLIMB_HEIGHT * climbProgress, 0)
	rootCollider.AssemblyLinearVelocity = Vector3.zero
	rootCollider.AssemblyAngularVelocity = Vector3.zero

	if elapsed >= CLIMB_TOTAL_DURATION then
		isClimbing = false
		climbStartCFrame = nil
		lastClimbTime = os.clock()
		climbGroundGraceUntil = lastClimbTime + 1.2
		forcePathRecompute = true
		lastPathMovePosition = rootCollider.Position
		lastPathMoveTime = os.clock()
	end

	return isClimbing
end

local function tryStartClimb(direction)
	if isClimbing or isJumping or os.clock() - lastClimbTime < CLIMB_COOLDOWN then
		return false
	end

	local result = raycastMovementObstacle(direction, CLIMB_SCAN_DISTANCE, CLIMB_SCAN_HEIGHT)

	if not isClimbableFenceHit(result) then
		return false
	end

	lastClimbTime = os.clock()
	isClimbing = true
	climbStartTime = lastClimbTime
	climbStartCFrame = rootCollider.CFrame

	faceTowards(rootCollider.Position + direction.Unit)
	clearPath()
	stopMovement()
	playClimb()

	return true
end

local function isJumpableObstacleHit(result)
	if not result or not result.Instance or not result.Instance:IsA("BasePart") then
		return false
	end

	if isClimbableFenceHit(result) then
		return false
	end

	local part = result.Instance
	local height = part.Size.Y

	return height >= JUMP_MIN_OBSTACLE_HEIGHT
		and height <= JUMP_MAX_OBSTACLE_HEIGHT
		and math.abs(result.Normal.Y) < 0.65
end

local function startJump(direction, speed)
	if direction.Magnitude <= 0.05 then
		return false
	end

	local now = os.clock()
	if isJumping or isClimbing or now - lastJumpTime < JUMP_COOLDOWN then
		return false
	end

	lastJumpTime = now
	isJumping = true
	jumpStartTime = now
	jumpDirection = Vector3.new(direction.X, 0, direction.Z).Unit
	jumpMoveSpeed = speed * JUMP_FORWARD_SPEED_MULTIPLIER
	jumpGroundGraceUntil = now + JUMP_DURATION + JUMP_GROUND_GRACE
	avoidancePoint = nil
	avoidancePointExpiresAt = 0
	forcePathRecompute = true

	faceTowards(rootCollider.Position + jumpDirection)
	playJump()

	rootCollider.AssemblyLinearVelocity = Vector3.new(
		jumpDirection.X * jumpMoveSpeed,
		JUMP_VERTICAL_SPEED,
		jumpDirection.Z * jumpMoveSpeed
	)
	rootCollider.AssemblyAngularVelocity = Vector3.zero

	return true
end

local function tryStartJump(direction, speed, forceJump)
	if direction.Magnitude <= 0.05 then
		return false
	end

	if not forceJump then
		local result = raycastMovementObstacle(direction, JUMP_SCAN_DISTANCE, JUMP_SCAN_HEIGHT)
		if not isJumpableObstacleHit(result) then
			return false
		end
	end

	return startJump(direction, speed)
end

local function updateJumpMotion()
	if not isJumping then
		return false
	end

	local elapsed = os.clock() - jumpStartTime
	local velocity = rootCollider.AssemblyLinearVelocity
	rootCollider.AssemblyLinearVelocity = Vector3.new(
		jumpDirection.X * jumpMoveSpeed,
		velocity.Y,
		jumpDirection.Z * jumpMoveSpeed
	)

	if elapsed >= JUMP_DURATION then
		isJumping = false
		forcePathRecompute = true
		lastPathMovePosition = rootCollider.Position
		lastPathMoveTime = os.clock()
	end

	return isJumping
end

