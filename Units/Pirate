local desiredYaw = 0
local currentSmoothedYaw = nil
local lastFaceTowardsTime = os.clock()

local function getShortestAngleDelta(fromYaw, toYaw)
	return math.atan2(math.sin(toYaw - fromYaw), math.cos(toYaw - fromYaw))
end

local function getSteppedYaw(targetYaw)
	local now = os.clock()
	local deltaTime = math.clamp(now - lastFaceTowardsTime, ROTATION_MIN_STEP_DELTA, ROTATION_MAX_STEP_DELTA)
	lastFaceTowardsTime = now

	local _, actualYaw, _ = rootCollider.CFrame:ToOrientation()
	currentSmoothedYaw = currentSmoothedYaw or actualYaw

	local delta = getShortestAngleDelta(currentSmoothedYaw, targetYaw)
	local maxStep = math.rad(ROTATION_TURN_SPEED_DEGREES) * deltaTime

	if math.abs(delta) <= maxStep then
		currentSmoothedYaw = targetYaw
	else
		currentSmoothedYaw += math.sign(delta) * maxStep
	end

	return currentSmoothedYaw
end

local function getYawFacingPosition(targetPosition)
	local currentPosition = rootCollider.Position
	local flatTarget = Vector3.new(targetPosition.X, currentPosition.Y, targetPosition.Z)
	local offset = flatTarget - currentPosition

	if offset.Magnitude <= 0.05 then
		local _, currentYaw, _ = rootCollider.CFrame:ToOrientation()
		return currentYaw
	end

	local lookCFrame = CFrame.lookAt(currentPosition, flatTarget)
	local _, yaw, _ = lookCFrame:ToOrientation()

	yaw += math.rad(MODEL_YAW_OFFSET_DEGREES)

	return yaw
end

local function faceTowards(targetPosition)
	desiredYaw = getYawFacingPosition(targetPosition)
	local steppedYaw = getSteppedYaw(desiredYaw)

	alignOrientation.CFrame = CFrame.Angles(0, steppedYaw, 0)

	if FORCE_DIRECT_ROTATION then
		local position = rootCollider.Position
		local velocity = rootCollider.AssemblyLinearVelocity

		rootCollider.CFrame = CFrame.new(position) * CFrame.Angles(0, steppedYaw, 0)
		rootCollider.AssemblyLinearVelocity = velocity
		rootCollider.AssemblyAngularVelocity = Vector3.zero
	end
end

