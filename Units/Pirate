local currentPath = nil
local currentWaypoints = {}
local currentWaypointIndex = 1
local currentPathTargetPosition = nil
local currentWaypointAction = nil
local lastPathComputeTime = -math.huge
local blockedPathConnection = nil
forcePathRecompute = true
lastPathMovePosition = rootCollider.Position
lastPathMoveTime = os.clock()
local avoidanceSide = 0
local lastAvoidanceDecisionTime = -math.huge
avoidancePoint = nil
avoidancePointExpiresAt = 0

clearPath = function()
	currentPath = nil
	currentWaypoints = {}
	currentWaypointIndex = 1
	currentPathTargetPosition = nil
	currentWaypointAction = nil
	forcePathRecompute = true
	lastPathComputeTime = -math.huge
	avoidanceSide = 0
	lastAvoidanceDecisionTime = -math.huge
	avoidancePoint = nil
	avoidancePointExpiresAt = 0

	if blockedPathConnection then
		blockedPathConnection:Disconnect()
		blockedPathConnection = nil
	end
end

local function shouldRecomputePath(targetPosition)
	local canRecomputeNow = os.clock() - lastPathComputeTime >= PATH_RECOMPUTE_INTERVAL

	if not currentPath or #currentWaypoints == 0 or not currentPathTargetPosition then
		return canRecomputeNow
	end

	if forcePathRecompute then
		return canRecomputeNow
	end

	if currentWaypointIndex > #currentWaypoints then
		return canRecomputeNow
	end

	if (targetPosition - currentPathTargetPosition).Magnitude >= PATH_TARGET_MOVE_THRESHOLD then
		return canRecomputeNow
	end

	return false
end

local function computePathTo(targetPosition)
	if not USE_PATHFINDING then
		return false
	end

	if not shouldRecomputePath(targetPosition) then
		return #currentWaypoints > 0
	end

	lastPathComputeTime = os.clock()
	forcePathRecompute = false

	if blockedPathConnection then
		blockedPathConnection:Disconnect()
		blockedPathConnection = nil
	end

	local path = PathfindingService:CreatePath({
		AgentRadius = PATH_AGENT_RADIUS,
		AgentHeight = PATH_AGENT_HEIGHT,
		AgentCanJump = PATH_AGENT_CAN_JUMP,
		AgentCanClimb = PATH_AGENT_CAN_CLIMB,
		WaypointSpacing = PATH_WAYPOINT_SPACING,
	})

	local ok, errorMessage = pcall(function()
		path:ComputeAsync(rootCollider.Position, targetPosition)
	end)

	if not ok or path.Status ~= Enum.PathStatus.Success then
		currentPath = nil
		currentWaypoints = {}
		currentWaypointIndex = 1
		currentPathTargetPosition = nil

		if not ok then
			warn("[PirateUnitAI] Pathfinding ComputeAsync failed:", errorMessage)
		end

		return false
	end

	currentPath = path
	currentWaypoints = path:GetWaypoints()
	currentWaypointIndex = (#currentWaypoints >= 2) and 2 or 1
	currentPathTargetPosition = targetPosition
	lastPathMovePosition = rootCollider.Position
	lastPathMoveTime = os.clock()

	blockedPathConnection = path.Blocked:Connect(function(blockedWaypointIndex)
		if blockedWaypointIndex >= currentWaypointIndex then
			forcePathRecompute = true
		end
	end)

	return #currentWaypoints > 0
end

local function getNextPathWaypoint(targetPosition)
	if not computePathTo(targetPosition) then
		return targetPosition
	end

	while currentWaypointIndex <= #currentWaypoints do
		local waypoint = currentWaypoints[currentWaypointIndex]
		local flatWaypoint = Vector3.new(waypoint.Position.X, rootCollider.Position.Y, waypoint.Position.Z)

		if (flatWaypoint - rootCollider.Position).Magnitude > PATH_WAYPOINT_REACHED_DISTANCE then
			currentWaypointAction = waypoint.Action
			return waypoint.Position
		end

		currentWaypointIndex += 1
	end

	currentWaypointAction = nil
	return targetPosition
end

local function updatePathStuckDetector()
	local now = os.clock()
	local flatCurrent = Vector3.new(rootCollider.Position.X, 0, rootCollider.Position.Z)
	local flatLast = Vector3.new(lastPathMovePosition.X, 0, lastPathMovePosition.Z)

	if (flatCurrent - flatLast).Magnitude >= PATH_STUCK_DISTANCE then
		lastPathMovePosition = rootCollider.Position
		lastPathMoveTime = now
		return
	end

	if now - lastPathMoveTime >= PATH_STUCK_TIME then
		forcePathRecompute = true
		lastPathMovePosition = rootCollider.Position
		lastPathMoveTime = now
	end
end

local function getClearDistance(direction)
	local result = raycastMovementObstacle(direction, AVOIDANCE_SCAN_DISTANCE)

	if not result then
		return AVOIDANCE_SCAN_DISTANCE
	end

	return (result.Position - (rootCollider.Position + Vector3.new(0, AVOIDANCE_SCAN_HEIGHT, 0))).Magnitude
end

local function getFlatDistance(a, b)
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

local function getObstacleSideClearance(result, sideVector)
	if not result or not result.Instance or not result.Instance:IsA("BasePart") then
		return AVOIDANCE_MIN_SIDE_CLEARANCE
	end

	local part = result.Instance
	local partCFrame = part.CFrame
	local halfSize = part.Size * 0.5
	local sideExtent = math.abs(sideVector:Dot(partCFrame.RightVector)) * halfSize.X
		+ math.abs(sideVector:Dot(partCFrame.UpVector)) * halfSize.Y
		+ math.abs(sideVector:Dot(partCFrame.LookVector)) * halfSize.Z

	return math.clamp(sideExtent + AVOIDANCE_SIDE_MARGIN, AVOIDANCE_MIN_SIDE_CLEARANCE, AVOIDANCE_MAX_SIDE_CLEARANCE)
end

local function chooseAvoidanceSide(direction)
	local now = os.clock()
	local left = Vector3.new(-direction.Z, 0, direction.X).Unit
	local right = Vector3.new(direction.Z, 0, -direction.X).Unit

	if avoidanceSide ~= 0 and now - lastAvoidanceDecisionTime < AVOIDANCE_DECISION_INTERVAL then
		return avoidanceSide, (avoidanceSide == 1) and left or right
	end

	local leftDiagonal = getClearDistance((direction + left * AVOIDANCE_SIDE_WEIGHT).Unit)
	local rightDiagonal = getClearDistance((direction + right * AVOIDANCE_SIDE_WEIGHT).Unit)
	local leftSide = getClearDistance(left)
	local rightSide = getClearDistance(right)
	local leftScore = leftDiagonal + leftSide * 0.75
	local rightScore = rightDiagonal + rightSide * 0.75

	avoidanceSide = (leftScore >= rightScore) and 1 or -1
	lastAvoidanceDecisionTime = now

	return avoidanceSide, (avoidanceSide == 1) and left or right
end

local function getAvoidanceMoveTarget(direction, defaultTargetPosition)
	local now = os.clock()
	local currentPosition = rootCollider.Position

	if avoidancePoint and now < avoidancePointExpiresAt then
		if getFlatDistance(currentPosition, avoidancePoint) > AVOIDANCE_POINT_REACHED_DISTANCE then
			return avoidancePoint
		end

		avoidancePoint = nil
		avoidancePointExpiresAt = 0
	end

	local frontHit = raycastMovementObstacle(direction, AVOIDANCE_SCAN_DISTANCE)

	if not frontHit or isClimbableFenceHit(frontHit) then
		avoidanceSide = 0
		avoidancePoint = nil
		avoidancePointExpiresAt = 0
		return defaultTargetPosition
	end

	local _, sideVector = chooseAvoidanceSide(direction)
	local sideClearance = getObstacleSideClearance(frontHit, sideVector)

	-- Идём не «чуть-чуть в сторону», а к отдельной обходной точке с запасом
	-- за габарит препятствия. Точка строится от текущей позиции, чтобы NPC
	-- сначала вышел вбок от камня/стены, а не пытался пройти сквозь её край.
	avoidancePoint = currentPosition
		+ sideVector * sideClearance
		+ direction * AVOIDANCE_FORWARD_CLEARANCE
	avoidancePointExpiresAt = now + AVOIDANCE_COMMIT_TIME
	forcePathRecompute = true

	return avoidancePoint
end

-- Вектор «прочь от соседних юнитов»: физически друг с другом они не
-- сталкиваются, поэтому расталкиваемся скриптом, чтобы не занимать одну точку.
local function getSeparationVector()
	local push = Vector3.zero

	for _, other in ipairs(CollectionService:GetTagged(UNIT_TAG)) do
		if other ~= npc and other.PrimaryPart then
			local away = rootCollider.Position - other.PrimaryPart.Position
			away = Vector3.new(away.X, 0, away.Z)
			local dist = away.Magnitude
			if dist > 0.05 and dist < SEPARATION_RADIUS then
				push = push + away.Unit * (1 - dist / SEPARATION_RADIUS)
			end
		end
	end

	return push
end

local function moveTowards(targetPosition, speed)
	local moveTargetPosition = getNextPathWaypoint(targetPosition)
	updatePathStuckDetector()

	local currentPosition = rootCollider.Position
	local flatTarget = Vector3.new(moveTargetPosition.X, currentPosition.Y, moveTargetPosition.Z)
	local offset = flatTarget - currentPosition

	if offset.Magnitude <= 0.1 then
		stopMovement()
		return
	end

	local desiredDirection = offset.Unit
	local flatDirectTarget = Vector3.new(targetPosition.X, currentPosition.Y, targetPosition.Z)
	local directTargetOffset = flatDirectTarget - currentPosition

	-- Если сам игрок прямо за забором, выбираем перелезание, даже если
	-- PathfindingService предлагает длинный обходной waypoint.
	if directTargetOffset.Magnitude > 0.1 and tryStartClimb(directTargetOffset.Unit) then
		return
	end

	if tryStartClimb(desiredDirection) then
		return
	end

	if directTargetOffset.Magnitude > 0.1 and tryStartJump(directTargetOffset.Unit, speed, false) then
		return
	end

	if currentWaypointAction == Enum.PathWaypointAction.Jump and tryStartJump(desiredDirection, speed, true) then
		return
	end

	if tryStartJump(desiredDirection, speed, false) then
		return
	end

	local avoidedTargetPosition = getAvoidanceMoveTarget(desiredDirection, flatTarget)
	local avoidedOffset = avoidedTargetPosition - currentPosition

	if avoidedOffset.Magnitude <= 0.1 then
		stopMovement()
		return
	end

	local movementDirection = avoidedOffset.Unit
	faceTowards(currentPosition + movementDirection)

	-- К направлению на цель добавляем разведение от соседей.
	local direction = movementDirection + getSeparationVector() * SEPARATION_STRENGTH
	if direction.Magnitude < 0.05 then
		direction = movementDirection
	else
		direction = direction.Unit
	end

	local currentYVelocity = math.min(rootCollider.AssemblyLinearVelocity.Y, MAX_UPWARD_VELOCITY)

	rootCollider.AssemblyLinearVelocity = Vector3.new(
		direction.X * speed,
		currentYVelocity,
		direction.Z * speed
	)
end

local function attackTarget(targetRoot, targetHumanoid)
	if isAttacking then
		return
	end

	local now = os.clock()

	if now - lastAttackTime < ATTACK_COOLDOWN then
		return
	end

	lastAttackTime = now
	isAttacking = true

	stopMovement()
	faceTowards(targetRoot.Position)
	playAttack()

	task.delay(ATTACK_HIT_DELAY, function()
		if not targetRoot.Parent then
			return
		end

		if not targetHumanoid.Parent then
			return
		end

		if targetHumanoid.Health <= 0 then
			return
		end

		local distance = (targetRoot.Position - rootCollider.Position).Magnitude

		if distance <= ATTACK_RANGE + 1 then
			targetHumanoid:TakeDamage(ATTACK_DAMAGE)
		end
	end)

	local attackDuration = attackTrack.Length

	if attackDuration <= 0 then
		attackDuration = ATTACK_COOLDOWN
	end

	task.delay(math.min(attackDuration, ATTACK_COOLDOWN), function()
		isAttacking = false
	end)
end

--====================================================
-- ГЛАВНЫЙ ЦИКЛ
--====================================================

playIdle()

RunService.Heartbeat:Connect(function()
	if not rootCollider.Parent then
		return
	end

	if isDead or getHealth() <= 0 then
		stopMovement()
		return
	end

	pcall(function()
		if rootCollider:GetNetworkOwner() ~= nil then
			rootCollider:SetNetworkOwner(nil)
		end
	end)

	if isClimbing then
		updateClimbMotion()
		return
	end

	if isJumping then
		updateJumpMotion()
		return
	end

	local now = os.clock()
	if now >= climbGroundGraceUntil and now >= jumpGroundGraceUntil then
		stabilizeOnGround()
	else
		limitUpwardLaunch()
	end

	-- 1. Если текущей цели нет, ищем игрока в обычном радиусе 20.
	if not currentTargetCharacter then
		local character = nil
		local root = nil
		local humanoid = nil
		local distance = nil

		character, root, humanoid, distance = findNearestTargetInRadius(DETECTION_RADIUS)

		if character and root and humanoid then
			currentTargetCharacter = character
			isChasingEscapedTarget = false
		else
			clearPath()
			stopMovement()
			playIdle()

			local _, yaw, _ = rootCollider.CFrame:ToOrientation()
			desiredYaw = yaw
			alignOrientation.CFrame = CFrame.Angles(0, desiredYaw, 0)

			return
		end
	end

	local targetRoot, targetHumanoid, distance = getTargetData(currentTargetCharacter)

	if not targetRoot or not targetHumanoid then
		clearTarget()
		stopMovement()
		playIdle()
		return
	end

	-- 2. Если цель вышла дальше 35, Пират забывает игрока.
	if distance > CHASE_GIVE_UP_DISTANCE then
		clearTarget()
		stopMovement()
		playIdle()
		return
	end

	-- 3. Если цель вышла за 20, включаем ускоренную погоню.
	if distance > DETECTION_RADIUS then
		isChasingEscapedTarget = true
	end

	-- 4. Если в режиме погони Пират приблизился до 5,
	-- выключаем ускоренную погоню.
	if isChasingEscapedTarget and distance <= CHASE_STOP_DISTANCE then
		isChasingEscapedTarget = false
	end

	-- Смотрим прямо на игрока только рядом с атакой. Во время дальнего
	-- движения moveTowards разворачивает NPC к следующей точке маршрута,
	-- чтобы он не шёл боком вокруг забора или камня.
	if distance <= ATTACK_RANGE + 2 then
		faceTowards(targetRoot.Position)
	end

	-- 5. Атака работает в любом режиме, если игрок близко.
	if distance <= ATTACK_RANGE then
		stopMovement()
		attackTarget(targetRoot, targetHumanoid)

		if not isAttacking then
			playIdle()
		end

		return
	end

	if isAttacking then
		stopMovement()
		return
	end

	-- 6. Если игрок уже замечен, пират не идёт шагом — только бежит.
	moveTowards(targetRoot.Position, MOVE_SPEED * RUN_SPEED_MULTIPLIER)
	playRun()
end)

